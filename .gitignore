# ===================================================================
# A general-purpose .gitignore file
#
# For language-specific templates, visit:
# https://github.com/github/gitignore
# ===================================================================

# Operating System Files
# ----------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*
Thumbs.db
ehthumbs.db

# Windows
desktop.ini


# IDEs and Editors
# ----------------
# JetBrains IDEs (IntelliJ, PyCharm, WebStorm, etc.)
.idea/
*.iml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.project
.classpath
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/


# Dependency Directories
# ----------------------
node_modules/
bower_components/
jspm_packages/
vendor/


# Build and Output Directories
# ----------------------------
build/
dist/
out/
target/
bin/
public/ # For frameworks that build into a public directory


# Log Files
# ---------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*


# Runtime Data
# ------------
pids/
*.pid
*.seed
*.pid.lock


# Temporary Files
# ---------------
*~
*.tmp
*.bak
*.swp
*.swo


# Environment Variables
# ---------------------
# Ignore all .env files, but not the example files
.env*
!.env.example
!.env.sample


# Test Reports & Coverage
# -----------------------
coverage/
.nyc_output/
mochawesome-report/
*.prof
*.profraw
*.lprof


# Miscellaneous
# -------------
# Compressed files (unless you explicitly want to track them)
*.zip
*.tar
*.gz
*.rar

# Compiled Python files
__pycache__/
*.py[cod]
*$py.class

# Sass cache
.sass-cache/

# Local user configuration
.user.ini
